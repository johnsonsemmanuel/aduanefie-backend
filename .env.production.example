APP_NAME=Aduanefie
APP_ENV=production
APP_DEBUG=false
APP_INSTALL=true
APP_LOG_LEVEL=error
APP_MODE=production
# This Laravel app is the operations/API host. The customer storefront is a
# separate Next.js app on https://aduanefie.com, so generated URLs (mail,
# password resets, queued jobs) must point at the ops host.
APP_URL=https://admin.aduanefie.com

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aduanefie_production
DB_USERNAME=aduanefie
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@aduanefie.com
MAIL_FROM_NAME="Aduanefie"

# Payment Gateways
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
STRIPE_KEY=
STRIPE_SECRET=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Africa payment rails
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# Trade Assurance
INSPECTOR_API_KEY=
INSPECTOR_API_ENDPOINT=

# Logistics Integration
LOGISTICS_API_KEY=
LOGISTICS_API_ENDPOINT=

# Customs Integration
CUSTOMS_API_KEY=
CUSTOMS_API_ENDPOINT=
