# ==============================================================================
# Aduanefie Marketplace — Production Environment (Railway)
# ==============================================================================
# Copy this to Railway as environment variables.
# NEVER commit real secrets to version control.
# ==============================================================================

# --- App ---
APP_NAME="Aduanefie Marketplace"
APP_ENV=production
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://admin.aduanefie.com
APP_MODE=prod
APP_HOST_DOMAIN=admin.aduanefie.com
APP_HOST_BASE_DOMAIN=aduanefie.com
APP_PUBLIC_IP=

# --- Logging ---
LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Database (Railway MySQL addon) ---
DB_CONNECTION=mysql
DB_HOST=${MYSQLHOST}
DB_PORT=${MYSQLPORT}
DB_DATABASE=${MYSQLDATABASE}
DB_USERNAME=${MYSQLUSER}
DB_PASSWORD=${MYSQLPASSWORD}
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt

# --- Redis (Railway Redis addon) ---
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

REDIS_HOST=${REDISHOST}
REDIS_PASSWORD=${REDISPASSWORD}
REDIS_PORT=${REDISPORT}
REDIS_URL=${REDIS_URL}

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@aduanefie.com
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS S3 (file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# --- Laravel Reverb (WebSockets) ---
REVERB_APP_ID=aduanefie
REVERB_APP_KEY=aduanefie
REVERB_APP_SECRET=CHANGE_ME
REVERB_HOST="${APP_URL}"
REVERB_PORT=6001
REVERB_SCHEME=https

# --- Pusher (compatible with Reverb) ---
PUSHER_APP_ID=${REVERB_APP_ID}
PUSHER_APP_KEY=${REVERB_APP_KEY}
PUSHER_APP_SECRET=${REVERB_APP_SECRET}
PUSHER_APP_CLUSTER=mt1
PUSHER_HOST="${APP_URL}"
PUSHER_PORT=6001
PUSHER_SCHEME=https

# --- OpenAI (AI Chatbot) ---
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# --- Firebase (Push Notifications + OTP) ---
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# --- Payment Gateways ---
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

RAZORPAY_KEY=
RAZORPAY_SECRET=

# --- SMS ---
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Software Version ---
SOFTWARE_VERSION=4.0
